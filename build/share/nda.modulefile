#%Module1.0
#
# To be installed as ${MODULEPATH}/nda/1.3.0

set     name        nda
set     version     1.3.0
set     root        /tmp/install
set     git_hash    f4062d77633bda0cb061c38bba91cb8d663cd292

set     url         "https://github.com/TRIQS/nda"
set     description "An example application using cpp2py and triqs."

module-whatis   "$description"

proc ModulesHelp { } {
    global description url version git_hash
    puts stderr "Description: $description"
    puts stderr "URL:         $url"
    puts stderr "Version:     $version"
    puts stderr "Git hash:    $git_hash"
}

# Only one version of nda can be loaded at a time
conflict $name

setenv          nda_ROOT      $root
setenv          nda_VERSION   $version
setenv          nda_GIT_HASH  $git_hash

prepend-path    PATH                $root/bin
prepend-path    LD_LIBRARY_PATH     $root/lib
prepend-path    CMAKE_PREFIX_PATH   $root

